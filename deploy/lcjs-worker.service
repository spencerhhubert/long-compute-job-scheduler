[Unit]
Description=Long Compute Job Scheduler worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lcjs-worker
Group=lcjs-worker
EnvironmentFile=/etc/lcjs-worker/worker.env
ExecStart=/usr/local/bin/lcjs worker run \
  --server https://control.example.com \
  --db /var/lib/lcjs-worker/worker.db \
  --project example=/srv/projects/example \
  --artifact-root /srv/lcjs/artifacts \
  --max-parallel 1
Restart=always
RestartSec=5s
KillMode=process
TimeoutStopSec=15s
NoNewPrivileges=true
PrivateDevices=false
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lcjs-worker /srv/lcjs/artifacts /srv/projects/example
UMask=0077

[Install]
WantedBy=multi-user.target
